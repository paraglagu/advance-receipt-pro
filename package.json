{
  "name": "advance-receipt-pro",
  "private": true,
  "scripts": {
    "build": "remix vite:build",
    "dev": "shopify app dev",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint .",
    "setup": "prisma generate && prisma migrate deploy",
    "start": "remix-serve ./build/server/index.js",
    "docker-start": "npm run setup && npm run start",
    "test": "pwsh -NoProfile -File scripts/run-tests.ps1",
    "prisma": "prisma"
  },
  "type": "module",
  "dependencies": {
    "@prisma/client": "5.22.0",
    "@remix-run/node": "^2.9.2",
    "@remix-run/react": "^2.9.2",
    "@remix-run/serve": "^2.9.2",
    "@shopify/app-bridge-react": "^4.1.6",
    "@shopify/polaris": "^13.3.0",
    "@shopify/shopify-app-remix": "^3.1.0",
    "@shopify/shopify-app-session-storage-prisma": "^5.1.0",
    "isbot": "^4.4.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@remix-run/dev": "^2.9.2",
    "@shopify/api-codegen-preset": "^1.1.1",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.2.5",
    "prisma": "5.22.0",
    "vite": "^5.2.11",
    "vite-tsconfig-paths": "^4.3.2"
  },
  "workspaces": [
    "extensions/*"
  ],
  "engines": {
    "node": ">=18.20.0"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.6": true,
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "esbuild@0.17.6": true,
    "esbuild@0.21.5": true,
    "prisma@5.22.0": true
  }
}
